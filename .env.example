# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Confirm model ids with: python -m scripts.check_live
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_TEXT=nvidia/nemotron-3-super-120b-a12b
# Leave empty to draft messages with MODEL_TEXT. Set to Ultra only if the eval shows it helps.
MODEL_EXPLAIN=

# 1 = ask Nemotron not to "think" before answering (faster, avoids empty replies). 0 = leave it on.
DISABLE_THINKING=1

# Tavily (live part-price search). basic = 1 credit and faster; advanced = 2 credits
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# Rule thresholds (shown to users)
PRICE_REVIEW_THRESHOLD_PCT=15
PRICE_MIN_COMPARABLES=3
PRICE_MIN_SELLERS=2
PRICE_MAX_AGE_DAYS=90
LINE_ROUNDING_TOLERANCE_INR=1
TOTAL_ROUNDING_TOLERANCE_INR=2
SCHEDULE_WINDOW_PCT=10
NORMALISE_MIN_CONFIDENCE=0.7
ESTIMATE_AMOUNT_TOLERANCE_PCT=10

# Timeouts (seconds)
MODEL_TIMEOUT_S=45
SEARCH_TIMEOUT_S=20

# Show the fictional sample vehicle (set 0 to hide it in production)
ALLOW_FICTIONAL_SAMPLE=1

# Accounts. People create an account (email + password) before checking their own bill.
# Samples and the dashboard stay open. AUTH_REQUIRED=0 turns sign-in off (tests, offline work only).
AUTH_REQUIRED=1
# Where accounts are stored (email + scrypt password hash + sessions). Keep it out of git.
USERS_DB=data/users.sqlite
# Or a Postgres URL (e.g. a free Neon database). When set, it is used instead of USERS_DB.
DATABASE_URL=
# Optional invite codes (comma-separated). If set, creating an account needs one of them.
SIGNUP_CODES=
SESSION_DAYS=7
# 1 when running behind a proxy/load balancer that sets X-Forwarded-For (e.g. most PaaS hosts)
TRUST_PROXY=0
# Per hour: photo readings per account, checks per account, model-backed requests per IP
RATE_READ_PER_HOUR=15
RATE_AUDIT_PER_HOUR=40
RATE_IP_PER_HOUR=60
# Failed sign-ins allowed per IP per 15 minutes; new accounts per IP per hour
LOGIN_ATTEMPTS=5
SIGNUPS_PER_HOUR=5
