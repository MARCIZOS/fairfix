# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Confirm model ids with: python scripts/smoke_test.py
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_TEXT=nvidia/nemotron-3-super-120b-a12b
# Leave empty to draft messages with MODEL_TEXT. Set to Ultra only if the eval shows it helps.
MODEL_EXPLAIN=

# Tavily (live part-price search)
TAVILY_API_KEY=

# Rule thresholds (shown to users)
PRICE_REVIEW_THRESHOLD_PCT=15
PRICE_MIN_COMPARABLES=3
PRICE_MIN_SELLERS=2
PRICE_MAX_AGE_DAYS=90
LINE_ROUNDING_TOLERANCE_INR=1
TOTAL_ROUNDING_TOLERANCE_INR=2
SCHEDULE_WINDOW_PCT=10
NORMALISE_MIN_CONFIDENCE=0.7
ESTIMATE_AMOUNT_TOLERANCE_PCT=10

# Timeouts (seconds)
MODEL_TIMEOUT_S=45
SEARCH_TIMEOUT_S=8

# Show the fictional sample vehicle (set 0 to hide it in production)
ALLOW_FICTIONAL_SAMPLE=1
